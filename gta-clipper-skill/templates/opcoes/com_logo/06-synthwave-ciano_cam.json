{
  "name": "cam",
  "description": "Estilo neon synthwave com logo. Backup do visual laranja: cam_laranja.json",
  "canvas": {
    "w": 1080,
    "h": 1920
  },
  "channel_name": "NOME DO CANAL",
  "layout": {
    "cam_height": 768,
    "game_height": 1152,
    "game_focus_x": 0.5
  },
  "card": {
    "anchor_y": 768,
    "max_width": 1000,
    "uppercase": true,
    "tag": {
      "font": {
        "file": "fonts/Montserrat-Black.ttf"
      },
      "size": 30,
      "uppercase": true,
      "color": "#FFFFFF",
      "bg": "#7A2CFF",
      "padding_x": 24,
      "padding_y": 8,
      "overlap": 12,
      "align": "center",
      "offset_x": 0,
      "position": "bottom",
      "border_color": "#22E4FF",
      "border_width": 3,
      "bg_gradient": [
        "#FF2BD6",
        "#7A2CFF"
      ],
      "border_gradient": [
        "#22E4FF",
        "#22E4FF"
      ]
    },
    "box": {
      "bg": "#0A0014",
      "border_color": "#FF7A00",
      "border_width": 5,
      "radius": 26,
      "padding_x": 30,
      "padding_y": 22,
      "line_gap": 8,
      "bg_gradient": [
        "#12002B",
        "#050008"
      ],
      "bg_image": {
        "file": "assets/logo.png",
        "blur": 10,
        "opacity": 0.12
      },
      "border_gradient": [
        "#FF2BD6",
        "#7A2CFF",
        "#22E4FF"
      ],
      "glow": {
        "radius": 9,
        "opacity": 0.8
      }
    },
    "line1": {
      "font": {
        "file": "fonts/Montserrat-Black.ttf"
      },
      "size": 80,
      "min_size": 44,
      "color": "#FF4FD8"
    },
    "line2": {
      "font": {
        "file": "fonts/Montserrat-Black.ttf"
      },
      "size": 60,
      "min_size": 36,
      "color": "#CFF6FF"
    },
    "logo": {
      "file": "assets/logo.png",
      "circle": true,
      "size": 165,
      "gap": 20
    },
    "text_glow": {
      "radius": 10,
      "opacity": 0.7
    }
  },
  "captions": {
    "font": {
      "file": "fonts/Poppins-ExtraBold.ttf"
    },
    "bold": false,
    "size": 69,
    "uppercase": true,
    "color": "#FFFFFF",
    "highlight_color": "#FE5CCD",
    "highlight_scale": 112,
    "outline": 4,
    "outline_color": "#000000",
    "shadow": 1,
    "x": 540,
    "max_words": 3,
    "max_chars": 16,
    "max_gap": 0.6,
    "anchor": "above_card",
    "gap": 30
  }
}