{
  "name": "cam",
  "description": "Vídeo COM webcam: facecam em cima (2/5), gameplay embaixo (3/5), card de título sobre a divisão, legenda na área da gameplay.",
  "canvas": {
    "w": 1080,
    "h": 1920
  },
  "channel_name": "NOME DO CANAL",
  "layout": {
    "cam_height": 768,
    "game_height": 1152,
    "game_focus_x": 0.5
  },
  "card": {
    "anchor_y": 768,
    "max_width": 960,
    "uppercase": true,
    "tag": {
      "font": {
        "file": "fonts/Montserrat-Black.ttf"
      },
      "size": 30,
      "uppercase": true,
      "color": "#000000",
      "bg": "#FF7A00",
      "padding_x": 24,
      "padding_y": 8,
      "overlap": 12,
      "align": "center",
      "offset_x": 0,
      "position": "bottom",
      "border_color": "#FFFFFF",
      "border_width": 4
    },
    "box": {
      "bg": "#120800",
      "border_color": "#FF7A00",
      "border_width": 6,
      "radius": 0,
      "padding_x": 36,
      "padding_y": 26,
      "line_gap": 8
    },
    "line1": {
      "font": {
        "file": "fonts/Montserrat-Black.ttf"
      },
      "size": 80,
      "min_size": 44,
      "color": "#FFD400"
    },
    "line2": {
      "font": {
        "file": "fonts/Montserrat-Black.ttf"
      },
      "size": 60,
      "min_size": 36,
      "color": "#FFFFFF"
    }
  },
  "captions": {
    "font": {
      "file": "fonts/Poppins-ExtraBold.ttf"
    },
    "bold": false,
    "size": 69,
    "uppercase": true,
    "color": "#FFFFFF",
    "highlight_color": "#FF7A00",
    "highlight_scale": 112,
    "outline": 4,
    "outline_color": "#000000",
    "shadow": 1,
    "x": 540,
    "max_words": 3,
    "max_chars": 16,
    "max_gap": 0.6,
    "anchor": "above_card",
    "gap": 30
  }
}