{
  "name": "nocam",
  "description": "Vídeo SEM webcam: fundo = vídeo ampliado e desfocado, meio = gameplay com leve zoom, título no topo, legenda na faixa desfocada de baixo.",
  "canvas": { "w": 1080, "h": 1920 },
  "channel_name": "",

  "layout": {
    "background": { "blur_radius": 28, "blur_passes": 3, "brightness": -0.12 },
    "game": { "zoom": 1.15, "y_center": 960, "focus_x": 0.5 }
  },

  "title": {
    "y_top": 190,
    "max_width": 980,
    "uppercase": true,
    "align": "center",
    "line_gap": 6,
    "outline": 10,
    "outline_color": "#000000",
    "line1": {
      "font": { "file": "fonts/Montserrat-Black.ttf" },
      "size": 92,
      "min_size": 52,
      "color": "#FFFFFF"
    },
    "line2": {
      "font": { "file": "fonts/Montserrat-Black.ttf" },
      "size": 92,
      "min_size": 52,
      "color": "#FFFFFF"
    }
  },

  "captions": {
    "font": { "file": "fonts/Poppins-ExtraBold.ttf" },
    "bold": false,
    "size": 84,
    "uppercase": true,
    "color": "#FFFFFF",
    "highlight_color": "#FFE600",
    "highlight_scale": 112,
    "outline": 8,
    "outline_color": "#000000",
    "shadow": 3,
    "x": 540,
    "y": 1560,
    "max_words": 3,
    "max_chars": 16,
    "max_gap": 0.6
  }
}
